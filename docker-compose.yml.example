version: '3.3'
services:
    deemix:
        image: ghcr.io/tony-vs-code/deemix-docker:latest
        container_name: Deemix
        volumes:
            - /your/storage/path/:/downloads
            - /your/config/location:/config
        environment:
            - PUID=1000
            - PGID=1000
            - UMASK_SET=022
        ports:
            - 6595:6595