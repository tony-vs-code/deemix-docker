#!/usr/bin/with-contenv bash

# Ensure directories exist and have open permissions for non-root containers
mkdir -p /downloads /config 2>/dev/null || true
chmod 777 /downloads /config 2>/dev/null || true

printf '[cont-init.d] Fixing Folder Permissions - Config Folder\n'
chown -R abc:abc /config 2>/dev/null || true

# find all folders in the download folder and own/chmod them gracefully
if [ ! -z "${DISABLE_OWNERSHIP_CHECK}" ]; then
    printf '[cont-init.d] Download Folder Ownership Check disabled by Environment Variable\n'
else
    printf '[cont-init.d] Fixing Folder Permissions - Downloads Folder\n'
    find /downloads -type d -exec chmod 777 {} + 2>/dev/null || true
    find /downloads -type d -exec chown abc:abc {} + 2>/dev/null || true
fi

# add executability to server
if [ -f "/deemix-server" ]; then
    chmod +x /deemix-server
fi

# Fix misconfigured download locations. The container's download map is always /downloads.
if [ -f "/config/config.json" ]; then
    jq '.downloadLocation = "/downloads"' /config/config.json > tmp.$$.json 2>/dev/null && mv tmp.$$.json /config/config.json 2>/dev/null || true
    chown abc:abc /config/config.json 2>/dev/null || true
    chmod 666 /config/config.json 2>/dev/null || true
fi
